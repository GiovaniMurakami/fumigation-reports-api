{
  "name": "fumigation-reports-api",
  "version": "1.0.0",
  "private": true,
  "description": "API Lambda para relatórios de tratamentos de fumigação",
  "main": "build/handler.js",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "build": "node esbuild.config.js",
    "start": "node build/local.js",
    "typecheck": "tsc --noEmit",
    "deploy:dev": "npm run build && serverless deploy --stage dev",
    "deploy:prod": "npm run build && serverless deploy --stage prod"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "@aws-sdk/s3-request-presigner": "^3.1023.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "serverless-http": "^3.2.0",
    "uuid": "^10.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.6",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.24.0",
    "serverless": "^4.4.6",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3"
  }
}
